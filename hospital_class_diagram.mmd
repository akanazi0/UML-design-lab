classDiagram

    %% Classes
    class Person {
        <<abstract>>
        +name : str
        +age : int
        +gender : str
        +address : str
        +phone_number : str
        +email : str
        +date_of_birth : str
        +blood_type : str
        +national_id : str
    }
    
    class Hospital {
        +name : str
        +add_department(dept: Department) void
        +register_patient(patient: Patient) void
        +schedule_appointment(patient: Patient, doctor: Doctor, date: str) Appointment
    }

    class Department {
        +name : str
        +add_doctor(doc: Doctor) void
    }

    class Doctor {
        +specialty : str
        +is_available : bool
        +mark_as_busy() void
        +mark_as_available() void
    }

    class Patient {
        +medical_record_number : str
        +medical_history : str
        +show_medical_history() str
    }

    class Appointment {
        +appointment_date : str
        +status : str
        +issue_prescription(med_name : str, dosage : str, instructions : str) Prescription
        +complete_appointment() void
        +cancel_appointment() void
    }

    class Prescription {
        +medication_name : str
        +dosage : str
        +instructions : str
    }
    
    %% Relationships
    Person <|.. Patient : implements
    Person <|.. Doctor : implements
    
    Hospital "1" *-- "*" Department : contains
    Hospital "1" *-- "*" Appointment : manages
    Hospital "1" o-- "*" Patient : registers

    Department "1" o-- "*" Doctor : employs

    Prescription "*" --> "1" Patient : prescribed_for
    Appointment "*" --> "1" Doctor : assigned_to
    Appointment "*" --> "1" Patient : booked_by
    Appointment "1" *-- "0..*" Prescription : generates
